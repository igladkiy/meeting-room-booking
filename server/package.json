{
  "name": "booking-server",
  "version": "1.0.0",
  "description": "Meeting room booking API with concurrency-safe conflict detection",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
